* text=auto
*.rs text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
# Preserve captured upstream bytes for provenance hash verification. These files
# are compared against the sha256 recorded in each source-manifest.json, so git
# must never normalize their line endings.
rulesets/*/sources/raw/** -text
